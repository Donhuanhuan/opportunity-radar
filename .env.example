# ===== 信号源 =====
# 启用哪些源，逗号分隔。可选: hackernews,github_trending,producthunt,kr36,weibo
RADAR_SOURCES=hackernews,github_trending,producthunt,kr36,weibo

# 推送渠道：feishu,email
NOTIFY_CHANNELS=feishu

# ===== 关键词（命中加分 / 减分 / 黑名单）=====
KEYWORDS_HOT=AI,SaaS,出海,跨境,短视频,数字人,工具,自动化,赚钱,副业
KEYWORDS_DEMAND=效率,提效,降本,变现,赚钱,省时间
KEYWORDS_BLOCK=赌博,博彩,传销,虚拟币,资金盘,黄,赌,毒

# ===== Top N =====
TOP_N=15

# ===== 飞书机器人（必填）=====
# 在飞书群 → 设置 → 群机器人 → 添加 → 自定义机器人，复制 Webhook URL
FEISHU_WEBHOOK=

# ===== 飞书多维表格 · 商机池（强烈推荐）=====
# 1) 飞书开放平台 https://open.feishu.cn/app 创建自建应用 → 凭证页拿到 App ID / App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 2) 在飞书新建多维表格 → URL 形如 https://xxx.feishu.cn/base/APP_TOKEN?table=TABLE_ID
#    字段需提前建好：标题(text) / 链接(url) / 来源(text) / 评分(number) / 标签(multi-select) / 摘要(text) / 日期(date) / 日报日期(text)
# 3) 多维表格右上角「...」→「添加文档应用权限」→ 勾上你创建的应用
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ===== 飞书多维表格 · 内容草稿（M2 内容工厂，可选）=====
# 沿用同一 app_token，建第二张表「内容草稿」
# 字段：商机标题(text) / 商机链接(url) / xhs标题(text) / xhs正文(text) / xhs标签(multi) /
#       xhs配图(text) / xhs发布要点(text) / zh标题1_理性(text) / zh标题2_悬念(text) /
#       zh标题3_实用(text) / zh正文(text) / zh关键点(text) / zh配图(text) / zh发布要点(text) /
#       状态(select: 待发/已发小红书/已发知乎/双发/跳过) / 生成时间(date)
DRAFTS_BITABLE_TABLE_ID=

# ===== 飞书多维表格 · 内容审核（M3 发布闸，可选）=====
# 沿用同一 app_token，建第三张表「内容审核」（schema 见 radar/publish/feishu_audit.py）
# 字段：草稿ID/商机标题/商机链接/平台/标题/正文/标签/状态(select: 待审/通过/拒绝/已发/失败)/审核备注/生成时间
FEISHU_AUDIT_TABLE_ID=

# ===== M3 本地发布（路径B：agent-browser 半本机）=====
# 总开关：off=只生成草稿不动发布；on=真正发布（先确保 cookie 已登录）
PUBLISH_ENABLED=off
# 发布节奏：conservative (≤1篇/天) / normal (≤3篇/天) / aggressive (≤5篇/天)
PUBLISH_PACE=conservative
# 单日硬上限（覆盖 PUBLISH_PACE）
PUBLISH_DAILY_LIMIT=1
# 连续失败 N 次则暂停今日发布
PUBLISH_MAX_RETRIES=2

# ===== LLM · M2 内容工厂（强烈推荐，否则文案质量只是模板）=====
# 三选一配置即可（按性价比推荐 DeepSeek）
# A) DeepSeek 国产便宜（推荐）：https://platform.deepseek.com  注册即送 ¥5 额度
DEEPSEEK_API_KEY=
# B) OpenAI：https://platform.openai.com  需要科学上网
OPENAI_API_KEY=
# C) Anthropic Claude：https://console.anthropic.com  需要科学上网
ANTHROPIC_API_KEY=

# ===== M2 处理条数（每日最多给多少条商机跑 LLM，控制成本）=====
M2_TOP_N=3

# ===== 内容质检闸（QC，第 4 环节：规则硬校验 + LLM 五维打分）=====
# on=启用；off=退回旧 3-Agent 行为（跳过质检）
QC_ENABLED=on
# LLM 打分及格线（0-100），低于触发重写一次，重写后仍低于 → 写表标「拒绝」拦截
QC_MIN_SCORE=75

# ===== 邮件（可选）=====
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your@qq.com
EMAIL_PASS=your_authorization_code
EMAIL_TO=target@x.com